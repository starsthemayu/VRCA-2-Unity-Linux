#!/usr/bin/env python3
import sys
import os
import subprocess
import glob
import time
import argparse
from pathlib import Path

VRCA_RECOVERY = os.path.expanduser("~/Downloads/VRCA-Recovery-Free-1.0.0")
UNITY = os.path.expanduser("~/Unity/Hub/Editor/2022.3.22f1/Editor/Unity")

# Colors
RED = '\033[91m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
MAGENTA = '\033[95m'
CYAN = '\033[96m'
WHITE = '\033[97m'
BOLD = '\033[1m'
RESET = '\033[0m'

def log(msg, color=WHITE):
    print(f"{color}[{time.strftime('%H:%M:%S')}] {msg}{RESET}")
    sys.stdout.flush()

def extract_vrca(vrca_path, output_path=None):
    vrca_path = os.path.abspath(vrca_path)
    if not os.path.exists(vrca_path):
        log(f"✗ Error: {vrca_path} not found", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False
    
    if output_path is None:
        name = Path(vrca_path).stem
        output_path = os.path.expanduser(f"~/Desktop/{name}.unitypackage")
    
    output_path = os.path.abspath(output_path)
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    temp_dir = f"/tmp/vrca_ext_{os.getpid()}_{int(time.time())}"
    os.makedirs(temp_dir, exist_ok=True)
    
    print(f"\n{BOLD}{MAGENTA}{'='*60}{RESET}")
    print(f"{BOLD}{CYAN}VRCA → UNITYPACKAGE EXTRACTOR{RESET}")
    print(f"{BOLD}{WHITE}Made by starzthedev{RESET}")
    print(f"{BOLD}{MAGENTA}{'='*60}{RESET}\n")
    
    log(f"▶ Starting extraction for: {BOLD}{os.path.basename(vrca_path)}{RESET}", CYAN)
    log(f"▶ Output: {output_path}", BLUE)
    
    log(f"\n[1/3] {BOLD}RECOVERING VRCA{RESET}", YELLOW)
    log("  ↳ Using VRCA-Recovery-Free...", WHITE)
    
    result = subprocess.run([
        VRCA_RECOVERY,
        "recover", vrca_path,
        "--output-root", temp_dir
    ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=1800)
    
    log("  ✓ Recovery complete", GREEN)
    print(result.stdout.decode()[-400:])
    
    log(f"\n[2/3] {BOLD}FINDING ASSETS{RESET}", YELLOW)
    projects = glob.glob(f"{temp_dir}/*_RecoveredProject")
    if not projects:
        log("✗ Error: No recovered project found", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False
    
    project_path = projects[0]
    log(f"  ✓ Found project: {os.path.basename(project_path)}", GREEN)
    
    prefabs = glob.glob(f"{project_path}/Assets/*.prefab")
    prefabs = [p for p in prefabs if not p.endswith('.meta')]
    if not prefabs:
        prefabs = [p for p in glob.glob(f"{project_path}/Assets/**/*.prefab", recursive=True) 
                   if not p.endswith('.meta') and 'VRCProjectSettings' not in p and '/Recovered/Libraries/' not in p]
    if not prefabs:
        prefabs = [p for p in glob.glob(f"{project_path}/Assets/**/*.prefab", recursive=True) 
                   if not p.endswith('.meta') and 'VRCProjectSettings' not in p]
    
    if not prefabs:
        log("✗ Error: No avatar prefab found", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False
    
    prefab_path = prefabs[0]
    prefab_rel = os.path.relpath(prefab_path, project_path)
    log(f"  ✓ Avatar prefab located", GREEN)
    log(f"    └─ {prefab_rel}", WHITE)
    
    os.makedirs(f"{project_path}/Assets/Editor", exist_ok=True)
    with open(f"{project_path}/Assets/Editor/VRCAExporter.cs", 'w') as f:
        f.write('''using UnityEditor;
using UnityEngine;
using System.IO;

public class VRCAExporter
{
    static void Export()
    {
        string argsFile = "/tmp/vrca_export_args.txt";
        if (!File.Exists(argsFile))
        {
            Debug.LogError("No args file");
            EditorApplication.Exit(1);
            return;
        }
        string[] args = File.ReadAllLines(argsFile);
        string prefabPath = args[0].Trim();
        string outputPath = args[1].Trim();
        
        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(outputPath)));
        
        AssetDatabase.ExportPackage(prefabPath, Path.GetFullPath(outputPath), 
            ExportPackageOptions.Recurse | ExportPackageOptions.IncludeDependencies);
        Debug.Log("VRCA_EXPORT_DONE:" + Path.GetFullPath(outputPath));
        EditorApplication.Exit(0);
    }
}
''')
    
    with open('/tmp/vrca_export_args.txt', 'w') as f:
        f.write(f"{prefab_rel}\n{output_path}\n")
    
    log(f"\n[3/3] {BOLD}EXPORTING TO UNITYPACKAGE{RESET}", YELLOW)
    log("  ↳ Running Unity in batchmode...", WHITE)
    log("  ↳ This may take several minutes...", CYAN)
    
    env = os.environ.copy()
    env['DISPLAY'] = ':99'
    
    try:
        result = subprocess.run([
            UNITY, "-batchmode", "-nographics",
            "-projectPath", project_path,
            "-executeMethod", "VRCAExporter.Export",
            "-logFile", "/tmp/vrca_export.log"
        ], env=env, timeout=1800)
    except subprocess.TimeoutExpired:
        log("✗ Error: Export timed out", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False
    except Exception as e:
        log(f"✗ Error: {e}", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False
    
    print()
    if os.path.exists(output_path):
        size_mb = os.path.getsize(output_path) / (1024*1024)
        print(f"{BOLD}{GREEN}{'='*60}{RESET}")
        log(f"✓ SUCCESS!", GREEN)
        log(f"  ↳ Exported to: {BOLD}{output_path}{RESET}", GREEN)
        log(f"  ↳ Size: {BOLD}{size_mb:.1f} MB{RESET}", GREEN)
        print(f"{BOLD}{GREEN}{'='*60}{RESET}\n")
        log("Made by starzthedev", MAGENTA)
        print()
        input(f"{YELLOW}Press Enter to exit...{RESET}")
        return True
    else:
        log("✗ Error: Export failed", RED)
        subprocess.run(['tail', '-30', '/tmp/vrca_export.log'])
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return False

def main():
    print(f"{BOLD}{MAGENTA}")
    print("╔══════════════════════════════════════════════════════════╗")
    print("║              VRCA → UNITYPACKAGE EXTRACTOR               ║")
    print("╚══════════════════════════════════════════════════════════╝")
    print(f"{RESET}")
    print(f"{CYAN}Made by starzthedev{RESET}\n")
    
    if len(sys.argv) == 1:
        print(f"{CYAN}Usage:{RESET} Drag and drop a .vrca file onto this script")
        print(f"{CYAN}   or:{RESET} run from terminal with file path\n")
        inp = input(f"{YELLOW}Enter path to .vrca file: {RESET}").strip().strip('"').strip("'")
        if not inp:
            sys.exit(1)
        inputs = [inp]
    else:
        parser = argparse.ArgumentParser(description='Extract VRCA files to UnityPackage')
        parser.add_argument('input', nargs='+', help='VRCA file(s) or directory')
        parser.add_argument('-o', '--output', help='Output file or directory')
        args = parser.parse_args()
        
        inputs = []
        for inp in args.input:
            if os.path.isdir(inp):
                inputs.extend(glob.glob(os.path.join(inp, "*.vrca")))
                inputs.extend(glob.glob(os.path.join(inp, "**/*.vrca"), recursive=True))
            elif inp.lower().endswith('.vrca'):
                inputs.append(inp)
            elif os.path.exists(inp):
                inputs.append(inp)
    
    if not inputs:
        log("✗ No VRCA files found", RED)
        input(f"\n{YELLOW}Press Enter to exit...{RESET}")
        return
    
    log(f"✓ Found {len(inputs)} VRCA file(s)", GREEN)
    print()
    
    for i, inp in enumerate(inputs):
        if len(inputs) > 1:
            log(f"Processing file {i+1}/{len(inputs)}", CYAN)
        extract_vrca(inp)
        if i < len(inputs) - 1:
            print(f"\n{MAGENTA}{'='*60}{RESET}\n")

if __name__ == '__main__':
    main()
